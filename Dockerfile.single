
# syntax=docker/dockerfile:1.7

FROM python:3.11-slim

WORKDIR /app

# Встановлення системних залежностей

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Встановлення всіх залежностей,
# включаючи навчальні

COPY requirements-train.txt requirements-api.txt ./

RUN pip install --no-cache-dir -r requirements-train.txt

# Копіювання коду

COPY src/model.py src/api.py ./src/

ARG EPOCHS=3

RUN mkdir -p /app/artifacts

# Навчання моделі всередині цього ж образу

RUN --mount=type=bind,from=dataset,source=.,target=/app/data,ro \
    python src/train.py \
    --data-dir /app/data \
    --output-dir /app/artifacts \
    --epochs ${EPOCHS} \
    --device cpu

ENV MODEL_PATH=/app/artifacts/model.pt
ENV METRICS_PATH=/app/artifacts/metrics.json
ENV MODEL_VERSION=1.0.0
ENV PYTHONUNBUFFERED=1

RUN useradd --create-home appuser && \
    chown -R appuser:appuser /app

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)" || exit 1

CMD ["uvicorn", "api:app", "--app-dir", "/app/src", "--host", "0.0.0.0", "--port", "8000"]
